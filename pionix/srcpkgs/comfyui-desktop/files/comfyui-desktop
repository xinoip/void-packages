#!/bin/sh
export APPDIR=/opt/comfyui-desktop
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
settings="$config_home/comfyui-desktop-2/settings.json"
data_dir="$config_home/comfyui-desktop"

if [ ! -e "$settings" ]; then
	mkdir -p "${settings%/*}" "$data_dir/ComfyUI-Shared/models" \
		"$data_dir/ComfyUI-Shared/input" "$data_dir/ComfyUI-Shared/output"
	jq -n --arg root "$data_dir" '{
		installDir: ($root + "/ComfyUI-Installs"),
		modelsDirs: [($root + "/ComfyUI-Shared/models")],
		inputDir: ($root + "/ComfyUI-Shared/input"),
		outputDir: ($root + "/ComfyUI-Shared/output")
	}' > "$settings"
fi

exec "$APPDIR/AppRun" "$@"
